# Two more php-fpm pools for agensio on the host (ddev's own pool keeps its unix socket
# for nginx inside the container): one on TCP 9000, published by docker-compose.agensio.yaml,
# and one on a unix socket in the bind-mounted /run/agensio (Linux hosts only). Same
# user, same docroot, 8 static children each.
ARG BASE_IMAGE
FROM $BASE_IMAGE
RUN for d in /etc/php/*/fpm/pool.d; do \
      printf '[agensio]\nuser = www-data\ngroup = www-data\nlisten = 0.0.0.0:9000\npm = static\npm.max_children = 8\npm.max_requests = 500\ncatch_workers_output = yes\nclear_env = no\n' > "$d/zz-agensio.conf"; \
      printf '[agensio-unix]\nuser = www-data\ngroup = www-data\nlisten = /run/agensio/php-fpm.sock\nlisten.mode = 0666\npm = static\npm.max_children = 8\npm.max_requests = 500\ncatch_workers_output = yes\nclear_env = no\n' > "$d/zz-agensio-unix.conf"; \
    done
