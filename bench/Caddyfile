# Caddy configuration for the benchmark. Run from the bench directory:
#   caddy run --config Caddyfile --adapter caddyfile
{
    admin off
    auto_https off
    servers {
        protocols h1 h2 h2c   # HTTP/2 through ALPN on 8445 and prior knowledge on 8082 (bench/h2/run.sh)
    }
}

http://127.0.0.1:8082 {
    root * www
    file_server
}

https://127.0.0.1:8445 {
    tls certs/cert.pem certs/key.pem
    root * www
    file_server
}
