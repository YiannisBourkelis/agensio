# Numbered rotations (access.log.1, access.log.2.gz) on every system, the names agensio's log queries
# read: RHEL's, Fedora's and Rocky's /etc/logrotate.conf turn dateext on for every program.
/var/log/agensio/*.log {
    daily
    rotate 14
    nodateext
    compress
    delaycompress
    missingok
    notifempty
    create 0640 agensio agensio
    sharedscripts
    postrotate
        [ -f /run/agensio.pid ] && kill -USR1 "$(cat /run/agensio.pid)" 2>/dev/null || true
    endscript
}

# Sites' own logs: <domain>.log as site-create writes them, <domain>/access.log as a hand-written
# site may. Each is agensio's with the site's group (0640), which the new file keeps, so the site's
# account goes on reading it after the rotation.
/var/log/agensio/sites/*.log /var/log/agensio/sites/*/*.log {
    daily
    rotate 14
    nodateext
    compress
    delaycompress
    missingok
    notifempty
    create 0640
    sharedscripts
    postrotate
        [ -f /run/agensio.pid ] && kill -USR1 "$(cat /run/agensio.pid)" 2>/dev/null || true
    endscript
}
