#!/bin/sh
install -d -o root -g agensio -m 0750 /etc/agensio
install -d -o agensio -g agensio -m 0750 /etc/agensio/sites.d /var/log/agensio /var/lib/agensio
install -d -m 0755 /var/www/html
[ -e /var/www/html/index.html ] || [ -n "$(ls -A /var/www/html 2>/dev/null)" ] || install -m 0644 /usr/share/agensio/www/index.html /var/www/html/index.html
chown root:agensio /etc/agensio/agensio.toml; chmod 0640 /etc/agensio/agensio.toml
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null; then systemctl daemon-reload || true; fi
exit 0
